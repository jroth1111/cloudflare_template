# Cloudflare Northstar Template - Environment Variables
# =====================================================
#
# Copy this file to .env (or apps/api/.dev.vars for Wrangler) and fill in the values.
#
# For local development:
#   1. Copy apps/api/.dev.vars.example to apps/api/.dev.vars
#   2. Fill in the values below
#   3. Run: pnpm dev
#
# For production deployment:
#   1. Run: pnpm cf:bootstrap (creates D1 database and KV namespace)
#   2. Update apps/api/wrangler.jsonc with real resource IDs
#   3. Set secrets via: wrangler secret put BETTER_AUTH_SECRET
#   4. Set environment vars in wrangler.jsonc production env
#   5. Run: pnpm deploy

# =============================================================================
# BETTER AUTH (required)
# =============================================================================

# Secret key for signing sessions/tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long

# Base URL of your application (must be HTTPS in production)
# Development: http://localhost:8787
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:8787

# =============================================================================
# CORS & AUTH ORIGINS (required for production)
# =============================================================================

# Allowed CORS origins (comma-separated)
# Development: http://localhost:3000,http://localhost:5173,http://localhost:8787
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8787

# Trusted origins for cookie-based auth (comma-separated)
# Usually same as CORS_ORIGINS
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8787

# =============================================================================
# OPTIONAL
# =============================================================================

# Environment: development | production
ENVIRONMENT=development

# Enable rate limiting on auth endpoints
AUTH_RATE_LIMIT_ENABLED=true
