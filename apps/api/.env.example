# Node-only env vars used by local CLIs (do not commit .env)
#
# Useful for:
# - Drizzle Kit (remote D1 HTTP API / Studio)
# - Any scripts that call Cloudflare APIs

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Better Auth (optional for CLI schema generation)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

