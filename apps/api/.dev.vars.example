# Wrangler local development secrets (do not commit .dev.vars)
#
# Docs:
# https://developers.cloudflare.com/workers/configuration/secrets/#local-development-with-secrets

# Better Auth
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_SECRET"
BETTER_AUTH_URL="http://localhost:8787" # must be https:// in production

# Optional (vars): auth rate limiting (enabled by default only in production)
# AUTH_RATE_LIMIT_ENABLED="true"
