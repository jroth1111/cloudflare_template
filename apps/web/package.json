{
  "name": "@cloudflare-northstar/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file ../../.dev.vars",
    "deploy": "wrangler deploy --minify --env production",
    "deploy:dev": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "hono": "^4.10.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare-northstar/api": "workspace:*",
    "@cloudflare/workers-types": "^4.20251213.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  }
}
